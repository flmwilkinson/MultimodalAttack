# COMET environment template (Ollama-first local configuration).
# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# Provider / local Ollama (OpenAI-compatible). Ollama needs no real key;
# "ollama" is a dummy kept for OpenAI SDK compatibility.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

TEXT_API_KEY=ollama
TEXT_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=ollama
VISION_BASE_URL=http://localhost:11434/v1
IMAGE_GEN_API_KEY=ollama
IMAGE_GEN_BASE_URL=http://localhost:11434/v1

# DeepSeek slot (kept pointed at local Ollama by default)
DEEPSEEK_API_KEY=ollama
DEEPSEEK_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Models -- must match what you have pulled in Ollama ( run: ollama list ).
# Keep VISION_MODEL vision-capable; it is the default target/refiner.
# ---------------------------------------------------------------------------
TEXT_MODEL=qwen3-vl:30b-a3b-instruct
ADVERSARIAL_MODEL=huihui_ai/qwen3-vl-abliterated:30b-a3b-instruct-q8_0
VISION_MODEL=qwen3-vl:30b-a3b-instruct
JUDGE_MODEL=qwen3-vl:32b

# Transmuter pipeline (attack-payload generation)
TRANSMUTER_PRIMARY_MODEL=qwen3-vl:30b-a3b-instruct
TRANSMUTER_FALLBACK_MODEL=qwen3-vl:30b-a3b-instruct

# ---------------------------------------------------------------------------
# Image generation backend: local_pillow | zimage | draw_things | remote
#   local_pillow  -> no extra model, always works (recommended to start)
#   zimage        -> Ollama native image model (needs: ollama pull x/z-image-turbo:latest)
# ---------------------------------------------------------------------------
IMAGE_GEN_BACKEND=local_pillow
IMAGE_GEN_MODEL=x/z-image-turbo:latest
DRAW_THINGS_ENDPOINT=http://127.0.0.1:7860/api/v1/generate

# ---------------------------------------------------------------------------
# Generation params / language
# ---------------------------------------------------------------------------
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=4096
EVAL_MAX_TOKENS=2048
OUTPUT_LANGUAGE=en
RUBRIC_LANGUAGE=en
TRANSLATION_PROVIDER=none
EXPORT_RESULTS_DIR=./logs/attack_runs/

# ---------------------------------------------------------------------------
# OPTIONAL cloud providers. Leave blank to stay fully local.
# To actually use a cloud model as --target/--judge/--refiner, pass the
# registered name with its provider prefix (e.g. openrouter/<model-id>); the
# code strips the prefix before calling the API.
# ---------------------------------------------------------------------------

# OpenRouter -- one key, many frontier + vision models (OpenAI-compatible).
# Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Real OpenAI (by default these point at local Ollama; set the real base URL to
# use api.openai.com). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# SiliconFlow -- cheap hosted big Qwen-VL models. https://siliconflow.cn
SILICONCLOUD_API_KEY=

# Anthropic (Claude). NOTE: not plug-and-play as an adaptive target yet.
ANTHROPIC_API_KEY=

# DeepL translation (not needed for English)
DEEPL_API_KEY=
